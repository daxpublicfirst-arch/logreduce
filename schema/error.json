{"$id":"https://github.com/daxpublicfirst-arch/logreduce/schema/error.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"The one JSON object printed to stdout on failure, with a non-zero exit code.","properties":{"error":{"properties":{"blocked":{"type":"string"},"code":{"enum":["INPUT_MISSING","INPUT_UNREADABLE","UNKNOWN_KIND","INVALID_INPUT","INVALID_REQUEST","USAGE","TOOL_FAILURE"],"type":"string"},"fix":{"type":"string"},"if_that_fails":{"type":"string"}},"required":["code","blocked","fix","if_that_fails"],"type":"object"},"ok":{"const":false,"type":"boolean"}},"required":["ok","error"],"title":"logreduce error response","type":"object"}