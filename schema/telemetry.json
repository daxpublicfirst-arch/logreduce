{"$id":"https://github.com/daxpublicfirst-arch/logreduce/schema/telemetry.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"One JSON line written to stderr per run. Never written to stdout.","properties":{"command":{"enum":["reduce","self-test","doctor","version"],"type":"string"},"duration_ms":{"minimum":0,"type":"integer"},"input_bytes":{"minimum":0,"type":"integer"},"ok":{"type":"boolean"},"output_bytes":{"minimum":0,"type":"integer"},"tool":{"const":"logreduce","type":"string"},"version":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$","type":"string"}},"required":["tool","version","command","duration_ms","input_bytes","output_bytes","ok"],"title":"logreduce telemetry line","type":"object"}